  "start": 302.56,
  "end": 304.06,
  "text": "Como tú sabes que quieres vender"
 },
 {
  "start": 304.06,
  "end": 305.86,
  "text": "Tú tratas de no verte chocante"
 },
 {
  "start": 305.86,
  "end": 307.18,
  "text": "Para que la persona no te termine"
 },
 {
  "start": 307.18,
  "end": 307.8,
  "text": "De decir que no"
 },
 {
  "start": 307.8,
  "end": 308.92,
  "text": "Entonces uno empieza"
 },
 {
  "start": 308.92,
  "end": 310.12,
  "text": "No, pero es que ¿Cómo así"
 },
 {
  "start": 310.12,
  "end": 311.44,
  "text": "Me va a decir usted eso?"
 },
 {
  "start": 311.8,
  "end": 312.54,
  "text": "Eso no"
 },
 {
  "start": 312.54,
  "end": 313.5,
  "text": "Este"
 },
 {
  "start": 313.5,
  "end": 314.68,
  "text": "No, usted tiene que entender"
 },
 {
  "start": 314.68,
  "end": 315.78,
  "text": "Que es por su familia"
 },
 {
  "start": 315.78,
  "end": 316.72,
  "text": "Tenga en cuenta"
 },
 {
  "start": 316.72,
  "end": 317.5,
  "text": "Que no sé qué más"
 },
 {
  "start": 317.5,
  "end": 318.38,
  "text": "Entonces uno"
 },
 {
  "start": 318.38,
  "end": 319.88,
  "text": "Le empieza a agarrar miedo"
 },
 {
  "start": 319.88,
  "end": 320.4,
  "text": "A la gente"
 },
 {
  "start": 320.4,
  "end": 322.14,
  "text": "Aunque parezca tonto"
 },
 {
  "start": 322.14,
  "end": 323.26,
  "text": "Uno es capaz de hablar y todo"
 },
 {
  "start": 323.26,
  "end": 324.24,
  "text": "Pero en el fondo"
 },
 {
  "start": 324.24,
  "end": 325.46,
  "text": "Uno tiene ese miedito"
 },
 {
  "start": 325.46,
  "end": 327.14,
  "text": "Y yo sé que muchos lo sienten"
 },
 {
  "start": 327.14,
  "end": 328.14,
  "text": "Uno tiene ese miedito"
 },
 {
  "start": 328.14,
  "end": 328.7,
  "text": "De cuando la gente"
 },
 {
  "start": 328.7,
  "end": 329.52,
  "text": "Te empieza a decir que no"
 },
 {
  "start": 329.52,
  "end": 329.9,
  "text": "Y tú dices"
 },
 {
  "start": 329.9,
  "end": 331.44,
  "text": "A ver, ya empezó la guerra"
 },
 {
  "start": 331.44,
  "end": 333.06,
  "text": "Aquí la guerra de quién gana"
 },
 {
  "start": 333.06,
  "end": 334.12,
  "text": "Si gana él con su objeción"
 },
 {
  "start": 334.12,
  "end": 335.14,
  "text": "O si gano yo con la mía"
 },
 {
  "start": 335.14,
  "end": 336.58,
  "text": "Entonces empieza esa guerra"
 },
 {
  "start": 336.58,
  "end": 337.68,
  "text": "Y uno anda con el miedito"
 },
 {
  "start": 337.68,
  "end": 338.36,
  "text": "Porque uno siente"
 },
 {
  "start": 338.36,
  "end": 339.84,
  "text": "Que esta persona me va a decir que no"
 },
 {
  "start": 339.84,
  "end": 340.84,
  "text": "Entonces yo tengo que tratar"
 },
 {
  "start": 340.84,
  "end": 341.96,
  "text": "De que me diga que sí ahorita"
 },
 {
  "start": 341.96,
  "end": 342.8,
  "text": "Perdón muchachos"
 },
 {
  "start": 342.8,
  "end": 344.03999999999996,
  "text": "Buen día, buen día, buen día"
 },
 {
  "start": 344.03999999999996,
  "end": 345.71999999999997,
  "text": "Vamos a comenzar en dos minuticos"
 },
 {
  "start": 345.71999999999997,
  "end": 347.82,
  "text": "Así que vamos alistándonos"
 },
 {
  "start": 347.82,
  "end": 349.0,
  "text": "Vamos sentándonos"
 },
 {
  "start": 349.0,
  "end": 350.38,
  "text": "En las oficinas"
 },
 {
  "start": 350.38,
  "end": 351.48,
  "text": "Y vamos"
 },
 {
  "start": 351.48,
  "end": 355.26,
  "text": "A ir encendiendo cámaras"
 },
 {
  "start": 355.26,
  "end": 356.02000000000004,
  "text": "Por favor"
 },
 {
  "start": 356.02000000000004,
  "end": 357.34000000000003,
  "text": "Buenos días, buenos días, buenos días"
 },
 {
  "start": 357.34000000000003,
  "end": 358.66,
  "text": "En dos minuticos comenzamos"
 },
 {
  "start": 358.66,
  "end": 359.44,
  "text": "Perfecto"
 },
 {
  "start": 359.44,
  "end": 360.3,
  "text": "Entonces bueno gente"
 },
 {
  "start": 360.3,
  "end": 360.84000000000003,
  "text": "Para finalizar"
 }
]