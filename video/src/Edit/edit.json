  },
  {
   "text": "en uno de los peores momentos",
   "from": 3473,
   "durationInFrames": 36
  },
  {
   "text": "de mi vida,",
   "from": 3509,
   "durationInFrames": 24
  },
  {
   "text": "económicamente hablando,",
   "from": 3533,
   "durationInFrames": 39
  },
  {
   "text": "fue donde tomé la decisión",
   "from": 3572,
   "durationInFrames": 36
  },
  {
   "text": "de estudiar y de prepararme",
   "from": 3608,
   "durationInFrames": 44
  },
  {
   "text": "para poder sacar una licencia",
   "from": 3652,
   "durationInFrames": 46
  },
  {
   "text": "financiera para trabajar",
   "from": 3698,
   "durationInFrames": 47
  },
  {
   "text": "en los Estados Unidos.",
   "from": 3745,
   "durationInFrames": 33
  },
  {
   "text": "No fue fácil para mí",
   "from": 3778,
   "durationInFrames": 28
  },
  {
   "text": "porque tuve que trabajar",
   "from": 3806,
   "durationInFrames": 42
  },
  {
   "text": "en dos trabajos,",
   "from": 3848,
   "durationInFrames": 42
  },
  {
   "text": "a la par tenía que estudiar",
   "from": 3890,
   "durationInFrames": 42
  },
  {
   "text": "y estuve preparándome por casi",
   "from": 3932,
   "durationInFrames": 70
  },
  {
   "text": "tres meses hasta que logré",
   "from": 4002,
   "durationInFrames": 43
  },
  {
   "text": "presentar el examen.",
   "from": 4045,
   "durationInFrames": 47
  },
  {
   "text": "No lo pasé a la primera,",
   "from": 4092,
   "durationInFrames": 54
  },
  {
   "text": "sino que seguí estudiando",
   "from": 4146,
   "durationInFrames": 41
  },
  {
   "text": "hasta que logré conseguir",
   "from": 4187,
   "durationInFrames": 35
  },
  {
   "text": "la licencia del Estado.",
   "from": 4222,
   "durationInFrames": 56
  },
  {
   "text": "Una vez empecé a trabajar",
   "from": 4278,
   "durationInFrames": 50
  },
  {
   "text": "en esto,",
   "from": 4328,
   "durationInFrames": 29
  },
  {
   "text": "yo me dedicaba a las dos",
   "from": 4357,
   "durationInFrames": 42
  },
  {
   "text": "cosas al mismo tiempo.",
   "from": 4399,
   "durationInFrames": 44
  },
  {
   "text": "Trabajaba en el almacén",
   "from": 4443,
   "durationInFrames": 31
  },
  {
   "text": "en la mañana y salía",
   "from": 4474,
   "durationInFrames": 39
  },
  {
   "text": "a mis citas en la tarde.",
   "from": 4513,
   "durationInFrames": 36
  },
  {
   "text": "Junto con el acompañamiento,",
   "from": 4549,
   "durationInFrames": 50
  },
  {
   "text": "el entrenamiento",
   "from": 4599,
   "durationInFrames": 24
  },
  {
   "text": "y el apoyo",
   "from": 4623,
   "durationInFrames": 26
  },
  {
   "text": "de mis supervisores,",
   "from": 4649,
   "durationInFrames": 35
  },
  {
   "text": "logré seguir adelante",
   "from": 4697,
   "durationInFrames": 29
  },
  {
   "text": "con el sector financiero.",
   "from": 4726,
   "durationInFrames": 50
  },
  {
   "text": "Y al día de hoy puedo",
   "from": 4776,
   "durationInFrames": 30
  },
  {
   "text": "decir que mi cheque del 100%",
   "from": 4806,
   "durationInFrames": 59
  },
  {
   "text": "proviene de esta oportunidad.",
   "from": 4865,
   "durationInFrames": 42
  },
  {
   "text": "Hoy en día puedo decir",
   "from": 4907,
   "durationInFrames": 28
  },
  {
   "text": "que mi situación financiera",
   "from": 4935,
   "durationInFrames": 45
  },
  {
   "text": "y mi mentalidad es mucho",
   "from": 4980,
   "durationInFrames": 42
  },
  {
   "text": "más fuerte.",
   "from": 5022,
   "durationInFrames": 13
  },
  {
   "text": "Y si tú estás",
   "from": 5035,
   "durationInFrames": 34
  },
  {
   "text": "en la misma situación",
   "from": 5069,
   "durationInFrames": 28
  },
  {
   "text": "y quieres la oportunidad",
   "from": 5097,
   "durationInFrames": 59
  },
  {
   "text": "de poder salir adelante,",
   "from": 5156,
   "durationInFrames": 48
  },
  {
   "text": "no dudes en escribirme.",
   "from": 5204,
   "durationInFrames": 46
  },
  {
   "text": "Tanto yo como mi equipo",
